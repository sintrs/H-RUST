+/// A tile's cells by block column. `Lod::surface` answers with the finest
+/// sample at that column, so a coarse tile carries whatever detail has arrived
+/// under it rather than its own reduced columns: the map draws no less than the
+/// samples hold.
+fn sample(lod: &horizon_client::lod::Lod, key: horizon_client::lod::TileKey) -> Cells {
+    let [origin_x, _, origin_z] = key.origin();
+    let stride = key.size() / 16;
+    (0..256_i32)
+        .map(|i| {
+            lod.surface(
+                origin_x + (i % 16) * stride + stride / 2,
+                origin_z + (i / 16) * stride + stride / 2,
+            )
+        })
         .collect()
 }
